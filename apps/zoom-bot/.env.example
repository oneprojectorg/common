# Zoom "General App" (account-level) OAuth client id, from the app's Basic Information page.
ZOOM_CLIENT_ID=
# Matching client secret from the same page.
ZOOM_CLIENT_SECRET=
# The chatbot's own JID, from the Team Chat (chatbot) feature page.
ZOOM_BOT_JID=
# Event Subscription secret token; verifies webhook signatures and answers Zoom's URL validation.
ZOOM_WEBHOOK_SECRET_TOKEN=
# Optional lockdown: our Zoom account id. Unset accepts webhooks from any account.
ZOOM_ACCOUNT_ID=

# Anthropic API key, from platform.claude.com. Read by the SDK itself.
ANTHROPIC_API_KEY=
# Managed Agent id printed by `pnpm w:zoom-bot run setup`. The app always uses its latest version.
ANTHROPIC_AGENT_ID=
# Managed Agent environment id printed by the same script.
ANTHROPIC_ENVIRONMENT_ID=
# Optional: workspace id, used only to build the console trace link the bot prints. Defaults to "default".
ANTHROPIC_WORKSPACE_ID=

# GitHub fine-grained PAT scoped to this repo with Contents: Read. Only ever sent to Anthropic's session API.
GITHUB_TOKEN=
# Optional: repository the agent reads. Defaults to https://github.com/oneprojectorg/common
GITHUB_REPO_URL=
# Optional: branch the agent reads. Defaults to dev
GITHUB_REPO_BRANCH=
# Optional: hard spend ceiling per question, in whole US cents. Defaults to 300 ($3.00).
SESSION_BUDGET_CENTS=
