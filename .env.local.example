## Postgres pool tuning (all optional; defaults shown).
## DB_POOL_MAX is the per-process connection pool size — tune to fit the
## Supavisor/Postgres connection budget divided by the number of API instances.
## The statement and in-transaction timeouts cap blast radius from a stuck query
## or a transaction holding a socket past the HTTP timeout.
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TXN_TIMEOUT_MS=60000
# DB_CONNECT_TIMEOUT_S=30
S3_ASSET_ROOT="http://127.0.0.1:54321/storage/v1/object/public/assets"

# Run this in your browser to generate this value:
# crypto.subtle.generateKey({name: "AES-CBC", length: 256,},true,["encrypt", "decrypt"]).then((key) => crypto.subtle.exportKey("jwk", key)).then(JSON.stringify).then(console.log); SSR_SECRETS_KEY={"alg":"A256CBC","ext":true,"k":"your_generated_token_here","key_ops":["encrypt","decrypt"],"kty":"oct"}
SSR_SECRETS_KEY={"alg":"A256CBC","ext":true,"k":"xUWFSEEnQPIlAkPqTxnIsZz5VRacNPEOzvG5ZBSJYN4","key_ops":["encrypt","decrypt"],"kty":"oct"}


## Redis (optional - falls back to in-memory cache if not set)
REDIS_URL=redis://localhost:6379

## OpenTelemetry
# OTLP HTTP export; the exporters append /v1/logs, /v1/traces, /v1/metrics
# to this base URL. Unset = telemetry export disabled.
# PostHog (EU) ingests logs + traces under its /i base path; the key is the
# project API key (same value as NEXT_PUBLIC_POSTHOG_KEY).
OTEL_EXPORTER_OTLP_ENDPOINT=https://eu.i.posthog.com/i
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <phc-project-api-key>
OTEL_SERVICE_NAME=common
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=local"

## PostHog source map upload (build-time only; used by withPostHogConfig in
## apps/app/next.config.mjs). Uploads only run on the `dev` and `main` deploy
## builds, so these are not needed for local dev — set them in the Vercel
## project env for those environments so production exception stacks symbolicate.
POSTHOG_API_KEY=<posthog-personal-api-key>
POSTHOG_ENV_ID=<posthog-project-id>

## TipTap Cloud (Real-time collaborative editing)
# Get your App ID and Secret from https://cloud.tiptap.dev/
NEXT_PUBLIC_TIPTAP_APP_ID=your-tiptap-app-id
TIPTAP_SECRET=your-tiptap-secret
# TIPTAP_PRO_TOKEN is needed for pnpm to install @tiptap-pro packages.
# Run before install: export TIPTAP_PRO_TOKEN="your-token" && pnpm install
# Or add to your shell profile for persistence.

## Iframely (Link preview embeds)
# Get your API key from https://iframely.com/
IFRAMELY_KEY=your-iframely-key

## DeepL (Machine Translation)
DEEPL_API_KEY=your-deepl-api-key

## OpenL via RapidAPI (Machine Translation for languages DeepL lacks, e.g. Somali)
OPENL_RAPIDAPI_KEY=your-openl-rapidapi-key

## AI model inference via @op/ai — works with any OpenAI-compatible provider.
# Deploy-level fallbacks only: the endpoint and key are normally configured at
# runtime (end-user/app config) and passed to @op/ai per agent.
AI_API_KEY=
AI_BASE_URL=

## MapTiler (optional — publishable client key for the location picker's
## basemap). When unset, the picker falls back to OpenFreeMap's public
## `liberty` style at https://tiles.openfreemap.org so the map still renders.
NEXT_PUBLIC_MAPTILER_API_KEY=

## Content Moderation — Checkstep serves both the sync gate and async review.
## Set the API key to turn moderation on; `MODERATION_PROVIDER` is optional and
## may only be `checkstep`.
##
## Policy taxonomy overrides — Checkstep policies are configured per-account
## (docs.checkstep.com/glossary), so the deployment's own codes trump ours.
## `MODERATION_POLICY_MAP` is a JSON object mapping Checkstep policy codes to
## our categories (`hate`/`violence`/`sexual`/`harassment`/`profanity`/`csam`/
## `other`). `MODERATION_DETACH_POLICIES` is a comma list of policy codes that
## trigger the mandatory-detach path (removal even from admin views). Both
## fall back to the adapter defaults. NOTE: each override REPLACES its default
## entirely — setting MODERATION_DETACH_POLICIES=CEX disables the TER detach;
## list every code the deployment wants detached.
MODERATION_PROVIDER=                 # checkstep (empty = off)
MODERATION_API_KEY=
MODERATION_POLICY_MAP=               # {"HTE":"hate","VLC":"violence","CEX":"csam",...}
MODERATION_DETACH_POLICIES=          # CEX,TER (account default)

## Twilio (SMS delivery — multi-modal notifications, ADR 0003)
## Leave TWILIO_ACCOUNT_SID empty to keep SMS off: the provider returns null
## rather than throwing, the same convention as MODERATION_PROVIDER above.
##
## The Account SID and Auth Token are on the Twilio Console dashboard. The two
## service SIDs are resources you create in the Console. Set either one, or
## both: each switches on its own capability, and setting neither is an error.
##   VERIFY    (VA...) confirms a phone number at signup. Twilio exempts this
##             traffic from A2P 10DLC, so it works immediately.
##   MESSAGING (MG...) sends notifications. Campaign review runs 10-15 days,
##             so register early. Always send through a Messaging Service and
##             never a bare `from` number: A2P 10DLC requires one, and sticky
##             sender and geomatch are Messaging Service features.
##
## Phase 1 needs VERIFY alone. Signup confirms a number weeks before a
## Messaging Service can send anything.
##
## TWILIO_AUTH_TOKEN also signs the inbound status-callback webhook, so it is
## required even where outbound calls use a scoped API key.
TWILIO_ACCOUNT_SID=                  # ACxxxxxxxx... (empty = SMS off)
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=           # VAxxxxxxxx... (enables phone confirmation)
TWILIO_MESSAGING_SERVICE_SID=        # MGxxxxxxxx... (enables sending)
