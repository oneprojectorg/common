{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "storybook-static/**",
        "build/**",
        "dist/**"
      ]
    },
    "build:e2e": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start:e2e": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format:check": {},
    // Phantom task: nothing runs it, but depending on it makes a task's hash
    // include the source files of the packages it depends on. Without it turbo
    // hashes only the package's own files, so editing shared config in
    // `@op/vitest-config` leaves every `test:coverage` a cache hit and the run
    // silently replays coverage measured under the old settings.
    "topo": {
      "dependsOn": ["^topo"]
    },
    "test": {
      "dependsOn": ["topo"]
    },
    "test:coverage": {
      "dependsOn": ["topo", "@op/styles#build"],
      "outputs": ["coverage/**"]
    },
    // `@op/common` and `@op/api` both run integration tests against the one
    // test Supabase, so `@op/api` waits for `@op/common`. CI runs
    // `pnpm test:coverage`, so the chain is on both `test` and `test:coverage`.
    "@op/api#test": {
      "dependsOn": ["topo", "@op/common#test"]
    },
    "@op/api#test:coverage": {
      "dependsOn": ["topo", "@op/styles#build", "@op/common#test:coverage"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:e2e": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "🔑 ------ PRIVATE VARS ------ 🔑",
    "RESEND_PASSWORD",
    "EMAIL_SMTP_URL",
    "SUPABASE_SERVICE_ROLE",
    "DATABASE_URL",
    "IFRAMELY_KEY",
    "GOOGLE_MAPS_API_KEY",
    "S3_ASSET_ROOT",
    "POSTHOG_API_KEY",
    "POSTHOG_ENV_ID",
    "SSR_SECRETS_KEY",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_RESOURCE_ATTRIBUTES",
    "OTEL_SERVICE_NAME",
    "MAILCHIMP_API_KEY",
    "MAILCHIMP_API_SERVER",
    "MAILCHIMP_AUDIENCE_ID",
    "OPENL_RAPIDAPI_KEY",
    "AI_API_KEY",
    "AI_BASE_URL",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_API_KEY_SID",
    "TWILIO_API_KEY_SECRET",
    "TWILIO_VERIFY_SERVICE_SID",
    "TWILIO_MESSAGING_SERVICE_SID",
    "🌎 ------ PUBLIC VARS ------ 🌎",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF",
    "NEXT_PUBLIC_VERCEL_ENV",
    "NEXT_PUBLIC_VERCEL_URL",
    "NEXT_PUBLIC_MAPTILER_API_KEY",
    "🧩 ------ SYSTEM VARS ------ 🧩",
    "NODE_ENV",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "VERCEL_GIT_COMMIT_REF",
    "💻 ------ DEVELOPMENT VARS ------ 💻",
    "DB_MIGRATING",
    "DB_SEEDING",
    "E2E",
    "INNGEST_DEV",
    "REDIS_URL",
    "TIPTAP_SECRET",
    "TIPTAP_PRIVATE_KEY",
    "TIPTAP_ENVIRONMENT_ID",
    "NEXT_PUBLIC_TIPTAP_APP_ID"
  ]
}
