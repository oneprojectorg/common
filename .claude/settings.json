{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(pnpm build:*)",
      "Bash(pnpm format)"
    ],
    "ask": []
  },
  "extraKnownMarketplaces": {
    "common-agent-toolkit": {
      "source": {
        "source": "git",
        "url": "git@github.com:oneprojectorg/common-agent-toolkit.git"
      }
    }
  },
  "enabledPlugins": {
    "devtools@common-agent-toolkit": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": ["."],
      "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "api.github.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.tiptap.dev",
        "*.anthropic.com",
        "docs.claude.com",
        "*.claude.com",
        "*.supabase.co",
        "*.supabase.com",
        "*.posthog.com",
        "api.posthog.com",
        "*.axiom.co",
        "mcp.axiom.co",
        "*.figma.com",
        "api.figma.com",
        "resend.com",
        "trpc.io",
        "zod.dev",
        "*.asana.com",
        "app.asana.com"
      ]
    },
    "excludedCommands": [
      "docker *",
      "docker-compose *",
      "supabase *"
    ],
    "allowUnsandboxedCommands": true,
    "failIfUnavailable": false
  }
}
