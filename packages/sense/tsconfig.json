{
  "extends": "@op/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".",
    "src"
  ],
  "exclude": ["dist", "build", "node_modules"]
}
